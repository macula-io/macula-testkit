{application, macula_testkit, [
    {description, "In-memory test support for macula consumers: a drop-in loopback pool (mem_macula) for hermetic pub/sub tests, and a Common Test hook that fails unallowed skips"},
    {vsn, "0.2.0"},
    {registered, []},
    {applications, [kernel, stdlib]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-io/macula-testkit"}]},
    %% What the hex package carries: rebar3_hex reads this, not rebar.config.
    {files, ["src", "rebar.config", "README.md", "CHANGELOG.md", "LICENSE"]}
]}.
